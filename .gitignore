# compiled binaries (this repo builds `katra` and `katra-mcp`)
# NOTE: `/katra` matches both the built binary AND the `katra/` data dir that
# `katra init` creates here (we dogfood). Re-include the directory so the log
# gets committed; only the bare binary file stays ignored.
/katra
/katra-mcp
!/katra/
/bin/
/dist/
*.test

# OS / editor
.DS_Store
